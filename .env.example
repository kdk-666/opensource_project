# 이 파일을 .env 로 복사해서 쓰세요. (.env 는 커밋되지 않습니다)

# NVIDIA GPU가 있으면 주석을 푸세요. (Windows는 구분 기호가 ; 입니다)
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml

# 요약·대본에 쓸 Ollama 모델 (기본: qwen2.5:3b)
# NEWSCARD_MODEL=qwen2.5:3b

# 음성 (기본 목소리: F2)
# newscard tts samples 로 10가지 목소리를 들어 보고 고르세요. 여성 F1~F5, 남성 M1~M5
# NEWSCARD_VOICE=F2
# NEWSCARD_TTS_SPEED=1.05
